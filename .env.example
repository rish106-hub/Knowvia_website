# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=rishavdewan10@gmail.com

# Waitlist storage. Required in production.
DATABASE_URL=

# Ad and product analytics. Scripts load only after visitor consent.
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Voice notes on the early-list form. Keep off until legal review signs off retention, transcription and deletion.
VOICE_NOTES_ENABLED=false
NEXT_PUBLIC_VOICE_NOTES_ENABLED=false

# Block 5 BFF (server-only; never prefix with NEXT_PUBLIC_). PROVISIONAL: identity (D1) and topology (D2) are open.
# Everything under /api/app/* answers 404 APP_DISABLED unless APP_ENABLED=true. See docs/block5/bff.md.
APP_ENABLED=false
# Base URL of the CoverSaath API (a non-public service). No trailing path.
COVERSAATH_API_URL=
# The backend household bootstrap token (32 to 256 chars of A-Z a-z 0-9 _ -). Held server-side only.
COVERSAATH_BOOTSTRAP_TOKEN=
# At least 32 random characters. Derives the AES-256-GCM key (HKDF) that seals the session cookies.
APP_SESSION_SECRET=
# Development-only identity provider: anyone can mint a synthetic household by email. Refused when NODE_ENV=production.
APP_DEV_IDENTITY=false
# Number of trusted proxies that append to X-Forwarded-For (0 to 5). 0 ignores X-Forwarded-For and X-Real-IP entirely
# (one shared sign-in bucket). Set it only when proxies you operate sit in front of this app.
APP_TRUSTED_PROXY_HOPS=0
# NODE_ENV must be exactly "development" or "test" for the dev identity and localhost origins. Anything else is production.
# Optional extra allowed browser origins for CSRF checks, comma separated. NEXT_PUBLIC_SITE_URL is always allowed.
APP_ALLOWED_ORIGINS=
