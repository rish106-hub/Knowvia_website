# Knowvia website configuration. Names only; never commit real values.
# Generate 32-byte keys with: openssl rand -base64 32

# --- Deployment ---
# development (default) | preview | production. Only production is indexable.
APP_ENV=development
# Canonical origin, no trailing slash. Required in production.
SITE_URL=http://localhost:3000
# Shown in the privacy notice and footer. Required in production.
PRIVACY_EMAIL=
RESPONSIBLE_OPERATOR_NAME=
# Set to true only after Indian legal review of /privacy, /terms and /cookies. Required in production.
LEGAL_REVIEW_APPROVED=false
# Proxies you operate in front of the app (1 for one load balancer). Used for rate limiting.
TRUSTED_PROXY_HOPS=1
# The product workspace route stays off in production unless explicitly enabled.
WORKSPACE_ENABLED=false

# --- Lead capture (disabled until all of these are set) ---
LEADS_ENABLED=true
# Postgres (Neon, RDS, Cloud SQL or Azure Database for PostgreSQL). Use TLS: ?sslmode=require
DATABASE_URL=
DB_POOL_MAX=5
LEAD_EMAIL_ENCRYPTION_KEY=
LEAD_EMAIL_ENCRYPTION_KEY_ID=k1
LEAD_EMAIL_HMAC_KEY=
# Retired encryption keys still needed to read old rows: id:base64key,id:base64key
LEAD_EMAIL_PREVIOUS_KEYS=
# Cloudflare Turnstile. Test keys for local work: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend. Required in preview and production; development prints the link to the server log instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Knowvia <hello@your-domain>
# ISO date when the launch campaign ended; launch-update leads are erased 90 days later.
LAUNCH_CAMPAIGN_ENDED_AT=
# Bearer token (32+ characters) for POST /api/internal/retention, called daily by your scheduler.
RETENTION_JOB_TOKEN=

# --- Analytics (loaded only after consent; build-time values) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GOOGLE_TAG_ID=
# Google Ads conversion target for a lead, e.g. AW-123456789/AbCdEf
NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION=
