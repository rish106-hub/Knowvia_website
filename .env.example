# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=rishavdewan10@gmail.com

# Waitlist storage. Required in production.
# Beta app opened after signup (defaults to https://knowviafrontend.vercel.app/).
# When set to an absolute https URL (http only for localhost), the post-signup button opens <value>/covers/add.
NEXT_PUBLIC_BETA_URL=
# Bearer token for GET /api/waitlist/admin. At least 32 random chars. Endpoint answers 404 when unset.
WAITLIST_ADMIN_TOKEN=
DATABASE_URL=

# Ad and product analytics. Scripts load only after visitor consent.
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Voice notes on the early-list form. Keep off until legal review signs off retention, transcription and deletion.
VOICE_NOTES_ENABLED=false
NEXT_PUBLIC_VOICE_NOTES_ENABLED=false

# Beta flow BFF (server only, never NEXT_PUBLIC_). The backend rejects browser origins, so every call goes through /api/beta/*.
# Base URL of the CoverSaath API, for example http://127.0.0.1:8787
BACKEND_API_URL=
# Same value as the backend KNOWVIA_BOOTSTRAP_TOKEN (32+ chars). Used only server side to open a household per e-mail.
KNOWVIA_BOOTSTRAP_TOKEN=
# Optional: encrypts the session cookie. Defaults to a key derived from KNOWVIA_BOOTSTRAP_TOKEN.
BETA_SESSION_SECRET=
