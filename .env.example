# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=rishavdewan10@gmail.com

# Waitlist storage. Required in production.
# Beta app opened after signup (defaults to https://knowviafrontend.vercel.app/).
NEXT_PUBLIC_BETA_URL=
# Bearer token for GET /api/waitlist/admin. At least 32 random chars. Endpoint answers 404 when unset.
WAITLIST_ADMIN_TOKEN=
DATABASE_URL=

# Ad and product analytics. Scripts load only after visitor consent.
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Voice notes on the early-list form. Keep off until legal review signs off retention, transcription and deletion.
VOICE_NOTES_ENABLED=false
NEXT_PUBLIC_VOICE_NOTES_ENABLED=false
